Subject: [TEST PATCH] Serialize sc0710 capture state and ring publication

Rebased on sc0710 PR #89 (5564ede7fb888b1448c9d8f140e98a1cdc7f7485).
Experimental GPL-2.0-or-later driver patch; hardware validation required.

diff --git a/lib/sc0710-audio.c b/lib/sc0710-audio.c
index 08dd0dc..fdd5254 100644
--- a/lib/sc0710-audio.c
+++ b/lib/sc0710-audio.c
@@ -48,21 +48,29 @@ static void sc0710_audio_push_frames(struct sc0710_audio_dev *chip,
 				     unsigned int samples, const u8 *src,
 				     unsigned int stride_bytes, bool silence)
 {
-	struct snd_pcm_substream *substream = chip->substream;
+	struct snd_pcm_substream *substream;
 	struct snd_pcm_runtime *runtime;
 	snd_pcm_uframes_t period_size;
+	unsigned long flags;
 	unsigned int i;
+	bool elapsed = false;
+
+	/* Video DMA may keep delivering after ALSA stops or enters recovery. */
+	spin_lock_irqsave(&chip->capture_lock, flags);
+	if (!chip->running)
+		goto unlock;
 
+	substream = chip->substream;
 	if (!substream)
-		return;
+		goto unlock;
 
 	runtime = substream->runtime;
 	if (!runtime || !runtime->dma_area || !runtime->buffer_size)
-		return;
+		goto unlock;
 
 	period_size = runtime->period_size;
 	if (!period_size)
-		return;
+		goto unlock;
 
 	for (i = 0; i < samples; i++) {
 		u32 *dst = (u32 *)(runtime->dma_area + chip->buffer_ptr * 4);
@@ -78,10 +86,19 @@ static void sc0710_audio_push_frames(struct sc0710_audio_dev *chip,
 	}
 
 	chip->period_pos += samples;
-	while (chip->period_pos >= period_size) {
-		chip->period_pos -= period_size;
-		snd_pcm_period_elapsed(substream);
+	if (chip->period_pos >= period_size) {
+		chip->period_pos %= period_size;
+		elapsed = true;
 	}
+
+unlock:
+	spin_unlock_irqrestore(&chip->capture_lock, flags);
+	/* ALSA takes its stream lock here; trigger takes it before capture_lock.
+	 * One notification publishes the current pointer, even for a batch that
+	 * crossed multiple periods. The channel mutex keeps substream alive.
+	 */
+	if (elapsed)
+		snd_pcm_period_elapsed(substream);
 }
 
 /* Frames of silence owed since the current gap began, paced by the clock
@@ -144,7 +161,7 @@ static void sc0710_audio_silence_work_fn(struct work_struct *work)
 	unsigned long deadline, now, next;
 
 	mutex_lock(&ch->lock);
-	if (!chip->running || !chip->substream) {
+	if (!READ_ONCE(chip->running) || !chip->substream) {
 		mutex_unlock(&ch->lock);
 		return;
 	}
@@ -152,7 +169,7 @@ static void sc0710_audio_silence_work_fn(struct work_struct *work)
 	/* One jiffies sample for both the check and the sleep length: a
 	 * re-read racing past the deadline would wrap the subtraction. */
 	now = jiffies;
-	deadline = chip->last_sample_jiffies + msecs_to_jiffies(SC0710_AUDIO_GAP_MS);
+	deadline = READ_ONCE(chip->last_sample_jiffies) + msecs_to_jiffies(SC0710_AUDIO_GAP_MS);
 	if (time_after(now, deadline)) {
 		if (audio_debug)
 			printk_ratelimited(KERN_INFO "%s: audio delivery gap, feeding ALSA silence\n",
@@ -170,7 +187,7 @@ static void sc0710_audio_silence_work_fn(struct work_struct *work)
 	}
 
 	/* re-check: running can be cleared via the ALSA trigger without ch->lock */
-	if (chip->running && chip->substream)
+	if (READ_ONCE(chip->running) && chip->substream)
 		mod_delayed_work(system_wq, &chip->silence_work, next);
 
 	mutex_unlock(&ch->lock);
@@ -305,7 +322,7 @@ int sc0710_audio_deliver_samples(struct sc0710_dev *dev,
 		return -1;
 
 	sc0710_audio_push_frames(chip, samplesPerChannel, buf, strideBytes, false);
-	chip->last_sample_jiffies = jiffies;
+	WRITE_ONCE(chip->last_sample_jiffies, jiffies);
 
 	sc0710_things_per_second_update(&ch->audioSamplesPerSecond,
 					samplesPerChannel * 2);
@@ -368,13 +385,16 @@ static int snd_sc0710_pcm_close(struct snd_pcm_substream *substream)
 	struct sc0710_audio_dev *chip = snd_pcm_substream_chip(substream);
 	struct sc0710_dev *dev = chip->dev;
 	struct sc0710_dma_channel *ch = &dev->channel[1];
+	unsigned long flags;
 
 	dprintk(1, "%s()\n", __func__);
 
 	/* Stop the hardware */
 	mutex_lock(&ch->lock);
+	spin_lock_irqsave(&chip->capture_lock, flags);
 	chip->running = false;
 	chip->substream = NULL;
+	spin_unlock_irqrestore(&chip->capture_lock, flags);
 	mutex_unlock(&ch->lock);
 
 	/* sync-cancel outside ch->lock (the work takes it); state cleared
@@ -430,12 +450,15 @@ static int snd_sc0710_prepare(struct snd_pcm_substream *substream)
 {
 	struct sc0710_audio_dev *chip = snd_pcm_substream_chip(substream);
 	struct sc0710_dev *dev = chip->dev;
-	//struct sc0710_dma_channel *ch = &dev->channel[1];
+	unsigned long flags;
 
 	dprintk(1, "%s() requested rate = %d\n", __func__, substream->runtime->rate);
 
+	spin_lock_irqsave(&chip->capture_lock, flags);
+	chip->running = false;
 	chip->buffer_ptr = 0;
 	chip->period_pos = 0;
+	spin_unlock_irqrestore(&chip->capture_lock, flags);
 
 	if (substream->runtime->rate != 48000) {
 		dprintk(1, "%s() audio rate mismatch (%u vs %u)\n", __func__, substream->runtime->rate, 48000);
@@ -451,6 +474,7 @@ static int snd_sc0710_capture_trigger(struct snd_pcm_substream *substream, int c
 {
 	struct sc0710_audio_dev *chip = snd_pcm_substream_chip(substream);
 	struct sc0710_dev *dev = chip->dev;
+	unsigned long flags;
 
 	dprintk(1, "%s() cmd %d\n", __func__, cmd);
 
@@ -460,8 +484,10 @@ static int snd_sc0710_capture_trigger(struct snd_pcm_substream *substream, int c
 		 * first silence fill lands one gap threshold later. Trigger
 		 * runs under snd_pcm_stream_lock (atomic); mod_delayed_work
 		 * is safe there. */
-		chip->last_sample_jiffies = jiffies;
+		spin_lock_irqsave(&chip->capture_lock, flags);
+		WRITE_ONCE(chip->last_sample_jiffies, jiffies);
 		chip->running = true;
+		spin_unlock_irqrestore(&chip->capture_lock, flags);
 		mod_delayed_work(system_wq, &chip->silence_work,
 				 msecs_to_jiffies(SC0710_AUDIO_GAP_MS));
 		/* Cam Link Pro exposes four standalone audio inputs, so ALSA must
@@ -476,7 +502,9 @@ static int snd_sc0710_capture_trigger(struct snd_pcm_substream *substream, int c
 
 	case SNDRV_PCM_TRIGGER_STOP:
 		/* atomic context: async cancel only; pcm_close() does the sync teardown */
+		spin_lock_irqsave(&chip->capture_lock, flags);
 		chip->running = false;
+		spin_unlock_irqrestore(&chip->capture_lock, flags);
 		cancel_delayed_work(&chip->silence_work);
 		if (atomic_read(&chip->dma_want)) {
 			atomic_set(&chip->dma_want, 0);
@@ -493,8 +521,13 @@ static snd_pcm_uframes_t snd_sc0710_capture_pointer(struct snd_pcm_substream
 						    *substream)
 {
 	struct sc0710_audio_dev *chip = snd_pcm_substream_chip(substream);
-	//printk("%s()\n", __func__);
-	return chip->buffer_ptr;
+	snd_pcm_uframes_t pointer;
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->capture_lock, flags);
+	pointer = chip->buffer_ptr;
+	spin_unlock_irqrestore(&chip->capture_lock, flags);
+	return pointer;
 }
 
 static struct page *snd_pcm_pd_get_page(struct snd_pcm_substream *subs,
@@ -607,6 +640,7 @@ static int sc0710_audio_register_one(struct sc0710_dev *dev, u8 input)
 	chip = (struct sc0710_audio_dev *)card->private_data;
 	chip->card = card;
 	chip->dev = dev;
+	spin_lock_init(&chip->capture_lock);
 	chip->buffer_ptr = 0;
 	chip->running = false;
 	chip->input = input;
diff --git a/lib/sc0710.h b/lib/sc0710.h
index 025d0b6..69f2fdc 100644
--- a/lib/sc0710.h
+++ b/lib/sc0710.h
@@ -579,6 +579,7 @@ struct sc0710_audio_dev
 	struct sc0710_dev         *dev;
 	struct snd_pcm_substream  *substream;
 	struct  snd_card          *card;
+	spinlock_t                 capture_lock; /* ALSA state and ring publication */
 	snd_pcm_uframes_t          buffer_ptr;
 	snd_pcm_uframes_t          period_pos;
 	bool                       running;
