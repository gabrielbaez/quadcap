-/* Delivery-gap watchdog, armed for the whole capture session. The DMA
- * path stops delivering samples on signal loss, across a resolution
- * switch's DMA stop/restart, and while HDMI audio renegotiates after a
- * mode change; a capture stream that makes no progress for 10 s is
- * killed by the ALSA core (read returns -EIO) and takes the app's audio
- * with it. Whenever real samples pause for longer than the gap
- * threshold this feeds silence in their place, so the stream survives
- * and real audio resumes seamlessly.
- * Runs in a kworker (process context), so it may take the sleeping
- * ch->lock -- unlike a timer callback (softirq), which caused a
- * "scheduling while atomic" panic on signal loss. */
+/* The channel mutex serializes this clock with real DMA delivery. The
+ * capture lock also excludes START/STOP and prepare, which ALSA may invoke
+ * independently of video. A late worker must account for elapsed time,
+ * rather than losing samples on every delayed wakeup.
+ */
+static unsigned int sc0710_audio_silence_due(struct sc0710_audio_dev *chip,
+					  u64 now, bool signal_present)
+{
+	struct snd_pcm_substream *substream;
+	u64 elapsed, frames, pending, limit;
+	unsigned long flags;
+	unsigned int due = 0;
+
+	spin_lock_irqsave(&chip->capture_lock, flags);
+	substream = chip->substream;
+	if (!chip->running || !substream || !substream->runtime ||
+	    now < chip->last_sample_ns)
+		goto unlock;
+
+	elapsed = now - chip->last_sample_ns;
+	/* Retain the DMA jitter allowance only while HDMI still has a signal. */
+	if (signal_present && elapsed < SC0710_AUDIO_GAP_MS * NSEC_PER_MSEC)
+		goto unlock;
+
+	frames = mul_u64_u32_div(elapsed, SC0710_AUDIO_RATE_HZ, NSEC_PER_SEC);
+	if (frames <= chip->silence_frames)
+		goto unlock;
+
+	pending = frames - chip->silence_frames;
+	limit = min_t(u64, substream->runtime->buffer_size / 2,
+		      SC0710_AUDIO_MAX_SILENCE_FRAMES);
+	if (!limit)
+		goto unlock;
+	/* A delayed worker must not lap the ring and expose stale samples.
+	 * Discard excess backlog but keep the current clock phase.
+	 */
+	due = min_t(u64, pending, limit);
+	chip->silence_frames = frames;
+
+unlock:
+	spin_unlock_irqrestore(&chip->capture_lock, flags);
+	return due;
+}
+
+/* Keep an open PCM moving across HDMI loss without sleeping under ALSA's
+ * stream lock. Signal flags are hints only: real samples reset the clock
+ * under the same channel mutex, so an input that resumes wins immediately.
+ */
